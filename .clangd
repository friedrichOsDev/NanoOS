CompileFlags:
  Compiler: /opt/cross/bin/x86_64-elf-gcc
  Add:
    - "--target=x86_64-elf"
    - "-x"
    - "c"
    - "-ffreestanding"
    - "-m64"
    - "-mcmodel=kernel"
    - "-mno-red-zone"
    - "-mno-mmx"
    - "-fno-stack-protector"
    - "-fno-builtin"
    - "-fno-strict-aliasing"
    - "-nostdlib"
    - "-O1"
    - "-std=c23"
    - "-Wall"
    - "-Wextra"
    - "-Werror"
    - "-Wpedantic"
    - "-Wconversion"
    - "-Wsign-conversion"
    - "-Warith-conversion"
    - "-Wfloat-equal"
    - "-Wpointer-arith"
    - "-Wwrite-strings"
    - "-Wenum-conversion"
    - "-Wshadow"
    - "-Wmissing-prototypes"
    - "-Wmissing-declarations"
    - "-Wredundant-decls"
    - "-Wnested-externs"
    - "-Wundef"
    - "-Wunused-const-variable=2"
    - "-Wmissing-include-dirs"
    - "-Wdate-time"
    - "-Wswitch-enum"
    - "-Wswitch-default"
    - "-Wimplicit-fallthrough=5"
    - "-Wlogical-op"
    - "-Wduplicated-cond"
    - "-Wduplicated-branches"
    - "-Wjump-misses-init"
    - "-Wnull-dereference"
    - "-Wstrict-overflow=2"
    - "-Wtrampolines"
    - "-Warray-bounds=2"
    - "-Wstringop-overflow=4"
    - "-Wstringop-truncation"
    - "-Wvla"
    - "-Walloca"
    - "-Walloc-zero"
    - "-Wstack-usage=4096"
    - "-Wframe-larger-than=4096"
    - "-Wattribute-alias=2"
    - "-Wformat=2"
    - "-Wformat-signedness"
    - "-Wformat-overflow=2"
    - "-Wformat-truncation=2"
    - "-fno-omit-frame-pointer"
    - "-fno-delete-null-pointer-checks"
    - "-fwrapv"
    - "-fno-common"
    - "-fno-pic"
    - "-fno-pie"
    - "-fcf-protection=none"
    - "-fno-asynchronous-unwind-tables"
    - "-I/workspace/src/kernel/include"
    - "-include"
    - "/workspace/src/kernel/include/pch.h"
    - "-Wno-unknown-warning-option"
